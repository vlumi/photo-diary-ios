    },
    "No instances yet" : {
      "comment" : "Heading of the front page's empty state when no instance is paired.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インスタンスがまだありません"
          }
        }
      },
      "extractionState" : "manual"
    },
    "No note yet" : {
