            "state" : "translated",
            "value" : "写真がありません"
          }
        }
      },
      "extractionState" : "manual"
    },
    "No photos with a location here yet. Long-press to drop a todo pin." : {
      "comment" : "Banner at the top of the map when the active instance has no geotagged photos; the map stays usable for todo pins.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
