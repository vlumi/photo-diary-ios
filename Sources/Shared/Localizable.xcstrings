{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ no longer lets you see what you were viewing." : {
      "comment" : "Notice on the front page after the server refused access to the scope the app was in. The argument is the instance name.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@で表示していた内容にアクセスできなくなりました。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "%@, %@" : {
      "comment" : "Accessibility description of a photo with a title: the title, then the photo's date and time.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@、%2$@"
          }
        }
      },
      "extractionState" : "manual"
    },
    "%lld" : {
      "comment" : "Badge on a map cluster pin: the number of photos gathered under it. Digits only.",
      "shouldTranslate" : false,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld"
          }
        }
      },
      "extractionState" : "manual"
    },
    "%lld photos" : {
      "comment" : "Two places: the caption under a gallery in the calendar's gallery list, and the accessibility label of a map cluster pin. The argument is the photo count.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld photo"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld photos"
                }
              }
            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld枚"
          }
        }
      },
      "extractionState" : "manual"
    },
    "(no note)" : {
      "comment" : "Placeholder title of a row in the todo-pin list when the pin has no note.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（メモなし）"
          }
        }
      },
      "extractionState" : "manual"
    },
    "About" : {
      "comment" : "Section header in Settings above the version, author and links.",
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリについて"
          }
        }
      }
    },
    "Add %@" : {
      "comment" : "Confirmation button in pairing that adds the instance; the argument is the server host name, e.g. photos.example.com.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を追加"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Add instance" : {
      "comment" : "Two places: the button at the bottom of Settings that starts pairing, and the title of the pairing screen it opens.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インスタンスを追加"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Add this instance?" : {
      "comment" : "Heading of the pairing confirmation section shown after a QR code or link is recognized.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このインスタンスを追加しますか？"
          }
        }
      },
      "extractionState" : "manual"
    },
    "All galleries" : {
      "comment" : "Subtitle of an instance row on the front page: tapping the row opens every gallery.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのギャラリー"
          }
        }
      },
      "extractionState" : "manual"
    },
    "All of %@" : {
      "comment" : "Link at the top of a year in the calendar that opens the whole year as one grid; the argument is the year, e.g. 2024.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@年すべて"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Built-in demo data" : {
      "comment" : "Caption under the demo instance in Settings, distinguishing it from paired servers.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内蔵のデモデータ"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Calendar" : {
      "comment" : "Tab bar label for the calendar tab.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カレンダー"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Camera scanning isn't available here" : {
      "comment" : "Title shown in place of the QR scanner when the device has no usable camera, e.g. in the simulator.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスではカメラでスキャンできません"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Cancel" : {
      "comment" : "Toolbar button that closes the todo-pin editor without saving.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャンセル"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Close" : {
      "comment" : "Accessibility label of the close button in the full-screen photo viewer and in the map callouts.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "閉じる"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Continue" : {
      "comment" : "Button next to the pasted pairing link that submits it; disabled until the link parses.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "続ける"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Couldn't load galleries" : {
      "comment" : "Title of the error state in the calendar when the server's gallery list could not be fetched.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ギャラリーを読み込めませんでした"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Couldn't load map" : {
      "comment" : "Title of the error state on the map tab when photo locations could not be fetched.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マップを読み込めませんでした"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Couldn't load photo" : {
      "comment" : "Heading over the error shown in the full-screen viewer when a photo's image fails to load.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真を読み込めませんでした"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Couldn't load photos" : {
      "comment" : "Title of the error state in a calendar photo grid when photos could not be fetched.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真を読み込めませんでした"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Couldn't reach %@: %@" : {
      "comment" : "Pairing error for a network failure. First argument is the host name, second the system's description of the failure.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@に接続できませんでした：%2$@"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Couldn't refresh. %@" : {
      "comment" : "Banner at the top of the map when a background refresh fails while pins are already showing. The argument is the error's own sentence.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新できませんでした。%@"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Delete pin" : {
      "comment" : "Destructive button at the bottom of the todo-pin editor, edit mode only.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ピンを削除"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Dismiss" : {
      "comment" : "Accessibility label of the close button on a map banner and on the front page's notice.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "閉じる"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Done" : {
      "comment" : "Two places: the toolbar button that closes the todo-pin list sheet, and the one that closes Settings.",
