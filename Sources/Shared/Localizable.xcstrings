        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Diaryのサイトとこのデバイスをペアリングして始めましょう。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Pairing failed: %@" : {
      "comment" : "Pairing error for an unexpected failure; the argument is the system's description of it.",
