        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフ"
          }
        }
      },
      "extractionState" : "manual"
    },
    "On" : {
      "comment" : "Accessibility value of the follow-my-location toggle while it is following.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オン"
          }
        }
      },
      "extractionState" : "manual"
    },
    "On the site, open the user menu and choose “Pair a device”. Then scan the code it shows, or paste the link." : {
      "comment" : "Instructions at the top of the pairing screen. “Pair a device” is the name of the menu item on the site.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイトのユーザーメニューから「デバイスをペアリング」を選び、表示されたコードをスキャンするか、リンクを貼り付けてください。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Open the site to sign in" : {
      "comment" : "Link under \"Session expired\" that opens the instance's site in the browser, where the user signs in and picks \"Pair a device\".",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイトを開いてログイン"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Opens the photo." : {
      "comment" : "Accessibility hint of a photo thumbnail in the calendar grid and the map callout.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真を開きます。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Or paste the pairing link" : {
      "comment" : "Section header above the text field for pasting a pairing link, as an alternative to scanning the QR code.",
      "localizations" : {
