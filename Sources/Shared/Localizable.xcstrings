            "state" : "translated",
            "value" : "次の写真"
          }
        }
      },
      "extractionState" : "manual"
    },
    "No active instance." : {
      "comment" : "Error shown in place of content if a screen is reached with no instance selected. Should not normally appear.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
