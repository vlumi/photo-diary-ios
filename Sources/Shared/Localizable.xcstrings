        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在地を追従"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Forget" : {
      "comment" : "Swipe action on an instance row on the front page that removes the instance and its session.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Images load with Nuke" : {
      "comment" : "Acknowledgment link in the About section; Nuke is the name of an open-source image loading library.",
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像の読み込みにNukeを使用"
          }
        }
      }
    },
    "Language" : {
      "comment" : "Label of the language picker in Settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言語"
          }
        }
      }
    },
    "List todo pins" : {
      "comment" : "Accessibility label of the map's list button (bulleted-list icon with a count badge).",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ToDoピンの一覧"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Location permission denied. Enable it in Settings." : {
      "comment" : "Banner at the top of the map when the user taps the location button but has denied location access.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報の利用が許可されていません。「設定」で許可してください。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Long-press the map to drop one." : {
      "comment" : "Hint under the empty state of the todo-pin list, telling how to create the first pin.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マップを長押しするとピンを置けます。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Made by" : {
      "comment" : "Row label in the About section; the value is the author's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作者"
          }
        }
