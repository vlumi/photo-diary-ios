            "value" : "位置情報のある写真がまだありません。長押しでToDoピンを置けます。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "No todo pins yet" : {
      "comment" : "Title of the empty state in the todo-pin list.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ToDoピンはまだありません"
          }
        }
