        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完了"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Edit note" : {
      "comment" : "Accessibility label of the pencil button that opens the todo-pin editor, on the map banner and on each list row.",
