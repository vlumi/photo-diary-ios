        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ピンを編集"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Follow my location" : {
      "comment" : "Accessibility label of the map's location button, a toggle: while on, the map keeps up with the user's position.",
